rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Planejamentos (plannerService)
    match /plans/{planId} {
      allow read, write: if isSignedIn();
    }

    // Metadados de anexos por operação (attachmentService)
    match /operations/{operationId}/attachments/{attachmentId} {
      allow read, write: if isSignedIn();
    }
  }
}